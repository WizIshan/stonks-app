<?xml version="1.0" encoding="utf-8"?>
<!--
  A rising trend line — the same mark the Dashboard leads with.

  Adaptive icons are 108x108 with only the middle 72x72 guaranteed visible after the
  launcher applies its mask, so everything here stays inside roughly 26..82 on both axes.
  Strokes are round-capped and joined so the line reads as one gesture at 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Baseline, at the same weight as a chart axis: present but recessive. -->
    <path
        android:pathData="M30,80 L80,80"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />

    <path
        android:pathData="M31,70 L45,56 L57,64 L77,36"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The current value, marked the way the trend chart marks its last point. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M77,29 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
